@model DashboardViewModel
@{
    ViewData["Title"] = "Campus Dashboard";
}

<!-- Dashboard Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-3 mb-4 border-bottom">
    <div>
        <h2 class="h3 fw-bold text-dark mb-1">Campus Service Dashboard</h2>
        <p class="text-muted mb-0">Overview of campus maintenance and student service requests</p>
    </div>
    <div class="mt-3 mt-md-0 d-flex gap-2">
        <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Submit New Request
        </a>
        <a asp-controller="Students" asp-action="Register" class="btn btn-outline-secondary">
            <i class="bi bi-person-plus me-1"></i> Register Student
        </a>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm dashboard-card bg-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle p-3 bg-primary bg-opacity-10 text-primary me-3 fs-3"><i class="bi bi-collection-fill"></i></div>
                <div>
                    <h6 class="text-muted text-uppercase mb-1 fw-bold fs-7 small">Total Requests</h6>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalRequests</h3>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="ServiceRequests" asp-action="Index" class="text-decoration-none text-primary small fw-semibold">View all requests <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm dashboard-card bg-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle p-3 bg-warning bg-opacity-10 text-warning me-3 fs-3"><i class="bi bi-hourglass-split"></i></div>
                <div>
                    <h6 class="text-muted text-uppercase mb-1 fw-bold small">Pending</h6>
                    <h3 class="fw-bold mb-0 text-dark">@Model.PendingRequests</h3>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Admin" asp-action="Index" asp-route-status="Pending" class="text-decoration-none text-warning small fw-semibold">Review pending <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm dashboard-card bg-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle p-3 bg-info bg-opacity-10 text-info me-3 fs-3"><i class="bi bi-gear-fill"></i></div>
                <div>
                    <h6 class="text-muted text-uppercase mb-1 fw-bold small">In Progress</h6>
                    <h3 class="fw-bold mb-0 text-dark">@Model.InProgressRequests</h3>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Admin" asp-action="Index" asp-route-status="In Progress" class="text-decoration-none text-info small fw-semibold">Review in progress <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm dashboard-card bg-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle p-3 bg-success bg-opacity-10 text-success me-3 fs-3"><i class="bi bi-check-circle-fill"></i></div>
                <div>
                    <h6 class="text-muted text-uppercase mb-1 fw-bold small">Completed</h6>
                    <h3 class="fw-bold mb-0 text-dark">@Model.CompletedRequests</h3>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Admin" asp-action="Index" asp-route-status="Completed" class="text-decoration-none text-success small fw-semibold">Review resolved <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Requests -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Recent Service Requests</h5>
                <a asp-controller="ServiceRequests" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th><th>Student</th><th>Category</th><th>Date</th><th>Status</th><th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentRequests.Any())
                            {
                                @foreach (var item in Model.RecentRequests)
                                {
                                    <tr>
                                        <td class="fw-semibold">#@item.Id</td>
                                        <td>
                                            <div class="fw-medium">@item.StudentName</div>
                                            <small class="text-muted">@(item.StudentRollNo ?? "N/A")</small>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@item.Category</span></td>
                                        <td class="text-muted small">@item.SubmissionDate.ToString("dd MMM yyyy")</td>
                                        <td><partial name="_StatusBadge" model="item.Status" /></td>
                                        <td class="text-end">
                                            <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="6" class="text-center py-4 text-muted">No service requests found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick actions + categories -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-lightning-charge-fill me-2 text-warning"></i>Quick Actions</h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-outline-primary text-start"><i class="bi bi-plus-circle me-2"></i> Submit Service Request</a>
                    <a asp-controller="ServiceRequests" asp-action="Track" class="btn btn-outline-secondary text-start"><i class="bi bi-search me-2"></i> Track Request Status</a>
                    <a asp-controller="Students" asp-action="Register" class="btn btn-outline-success text-start"><i class="bi bi-person-plus me-2"></i> Register New Student</a>
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-dark text-start"><i class="bi bi-shield-check me-2"></i> Admin Management Portal</a>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-grid-fill me-2 text-primary"></i>Service Categories</h6>
            </div>
            <ul class="list-group list-group-flush small">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-laptop me-2 text-primary"></i>IT Support</span><span class="text-muted">Wi-Fi, Labs, Portal</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-building me-2 text-success"></i>Hostel</span><span class="text-muted">Rooms, Water, Facilities</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-book me-2 text-info"></i>Library</span><span class="text-muted">Books, E-Resources, Cards</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-wrench me-2 text-warning"></i>Maintenance</span><span class="text-muted">Electrical, Plumbing, Classrooms</span>
                </li>
            </ul>
        </div>
    </div>
</div>
