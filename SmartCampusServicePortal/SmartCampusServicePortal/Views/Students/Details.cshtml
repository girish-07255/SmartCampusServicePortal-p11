@model Student
@{
    ViewData["Title"] = "Student Profile";
    var requests = ViewBag.Requests as List<ServiceRequest> ?? new List<ServiceRequest>();
}

<div class="row g-4">
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="display-4 text-primary"><i class="bi bi-person-circle"></i></div>
                <h5 class="fw-bold mb-0">@Model.FullName</h5>
                <div class="text-primary fw-semibold">@Model.StudentIdNumber</div>
                <span class="badge bg-light text-dark border mt-2">@Model.Department</span>
                <hr />
                <p class="mb-1 small"><i class="bi bi-envelope me-2"></i>@Model.Email</p>
                <p class="mb-1 small"><i class="bi bi-telephone me-2"></i>@Model.PhoneNumber</p>
                <p class="mb-0 small text-muted">Registered @Model.RegisteredDate.ToString("dd MMM yyyy")</p>
            </div>
            <div class="card-footer bg-white"><a asp-action="Index" class="btn btn-outline-secondary w-100"><i class="bi bi-arrow-left me-1"></i>Back to Directory</a></div>
        </div>
    </div>
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3"><h6 class="fw-bold mb-0">Service Requests by this student</h6></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light"><tr><th>Ticket</th><th>Category</th><th>Description</th><th>Date</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var r in requests)
                        {
                            <tr>
                                <td><a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@r.Id" class="fw-bold text-decoration-none">#@r.Id</a></td>
                                <td>@r.Category</td>
                                <td class="desc-cell">@r.Description</td>
                                <td class="small text-muted">@r.SubmissionDate.ToString("dd MMM yyyy")</td>
                                <td><partial name="_StatusBadge" model="r.Status" /></td>
                            </tr>
                        }
                        @if (!requests.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No requests submitted yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
