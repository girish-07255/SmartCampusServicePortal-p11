@model IEnumerable<ServiceRequest>
@{
    ViewData["Title"] = "Service Requests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0">Campus Service Requests</h3>
        <small class="text-muted">Browse and manage all submitted campus requests</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Submit New Request</a>
        <a asp-action="Track" class="btn btn-outline-secondary"><i class="bi bi-search me-1"></i>Track Request</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ticket #</th><th>Student Name</th><th>Category</th><th>Description</th><th>Submitted Date</th><th>Status</th><th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold"><a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">#@item.Id</a></td>
                        <td>
                            <div>@item.StudentName</div>
                            <small class="text-muted">@item.StudentRollNo</small>
                        </td>
                        <td><span class="badge bg-light text-dark border">@item.Category</span></td>
                        <td class="desc-cell">@item.Description</td>
                        <td class="small text-muted">@item.SubmissionDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td><partial name="_StatusBadge" model="item.Status" /></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Details"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No service requests found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
