<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Campus Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-mortarboard-fill me-2"></i>Smart Campus Portal
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-tools me-1"></i>Service Requests</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="ServiceRequests" asp-action="Index">All Requests</a></li>
                            <li><a class="dropdown-item" asp-controller="ServiceRequests" asp-action="Create">Submit New Request</a></li>
                            <li><a class="dropdown-item" asp-controller="ServiceRequests" asp-action="Track">Track Request</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-people me-1"></i>Students</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Students" asp-action="Index">Student Directory</a></li>
                            <li><a class="dropdown-item" asp-controller="Students" asp-action="Register">Register Student</a></li>
                            <li><a class="dropdown-item" asp-controller="Students" asp-action="Dashboard">Student Portal</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Index"><i class="bi bi-shield-check me-1"></i>Admin Panel</a>
                    </li>
                </ul>
                <div class="d-flex gap-2">
                    <a href="/api/servicerequests" target="_blank" class="btn btn-sm btn-outline-light"><i class="bi bi-code-slash me-1"></i>REST API (JSON)</a>
                    <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-sm btn-light text-primary"><i class="bi bi-plus-lg me-1"></i>New Request</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="border-top bg-white py-3">
        <div class="container d-flex justify-content-between align-items-center small text-muted">
            <span>&copy; @DateTime.Now.Year Smart Campus Service Portal - ASP.NET Core MVC Practical Project</span>
            <span>
                <span class="badge text-bg-light border"><i class="bi bi-database me-1"></i>SQL Server</span>
                <span class="badge text-bg-light border"><i class="bi bi-globe me-1"></i>Web API Integrated</span>
            </span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
